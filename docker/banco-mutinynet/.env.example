# Mosaik Arkade-on-Mutinynet — secrets and per-deployment knobs.
#
#   cp docker/banco-mutinynet/.env.example docker/banco-mutinynet/.env
#
# Edit the marked values. Never commit `.env`.

# ─── arkd-wallet ─────────────────────────────────────────────────────────────
# A BIP-39 mnemonic — anything you generated locally is fine for dev.
# REGTEST/MUTINYNET ONLY. Do not use for mainnet wallets.
ARKD_WALLET_MNEMONIC="<<replace with a 12 or 24 word mutinynet-only mnemonic>>"

# Optional admin password gating arkd-wallet's admin endpoints.
ARKD_WALLET_ADMIN_PASSWORD="<<set a random string>>"

# ─── arkd ────────────────────────────────────────────────────────────────────
# Admin password gating arkd's admin port (7071).
ARKD_ADMIN_PASSWORD="<<set a random string>>"

# Cosigner public keys arkd will accept signatures from. The introspector
# pubkey for the deployed introspector container goes here once you've
# generated `INTROSPECTOR_SECRET_KEY` below and derived its pubkey.
#   docker run --rm ${INTROSPECTOR_IMAGE} pubkey ${INTROSPECTOR_SECRET_KEY}
ARKD_INTROSPECTOR_PUBKEY="<<derive from INTROSPECTOR_SECRET_KEY>>"

# ─── Introspector ────────────────────────────────────────────────────────────
# 32-byte hex secret key. Generate with:
#   openssl rand -hex 32
INTROSPECTOR_SECRET_KEY="<<32 bytes hex>>"

# ─── bancod (only if you uncomment the bancod service) ───────────────────────
BANCOD_WALLET_SEED="<<another mnemonic — used as bancod's MM wallet>>"
