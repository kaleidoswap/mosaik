# Pinned upstream image versions for the Mosaik covenant-DEX platform.
#
# Bump these in a single PR. Composes interpolate `${VAR}` via the
# `--env-file docker/.versions.env` flag (wired in the root Makefile).
#
# When you bump a tag, also re-run `make test-stack` to confirm the
# bring-up sequence still works.

# ─── Mosaik first-party images (built locally until ghcr push lands) ─────────
MOSAIK_API_IMAGE=mosaik-api:dev
BANCO_PROXY_IMAGE=banco-proxy:dev
MOSAIK_RELAY_IMAGE=mosaik-relay-server:dev
MOSAIK_WEBAPP_IMAGE=mosaik-webapp:dev

# ─── Arkade ──────────────────────────────────────────────────────────────────
# `latest` until upstream cuts versioned tags we want to follow; pin to a
# specific digest in production. Both arkd and arkd-wallet ship from the
# same release in the arkade-os/arkd repo.
ARKD_IMAGE=ghcr.io/arkade-os/arkd:latest
ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:latest

# Liveness cosigner. Source: arklabshq/introspector (separate org).
INTROSPECTOR_IMAGE=ghcr.io/arklabshq/introspector:v0.0.1

# bancod (taker bot / auto-MM) has no published image yet; we build it from
# this commit in docker/bancod.Dockerfile.
BANCOD_REPO=https://github.com/arkade-os/bancod.git
BANCOD_REF=main

# ─── Bitcoin / Mutinynet plumbing ────────────────────────────────────────────
# NBXplorer talks to a Bitcoin Core RPC. Mutinynet is a custom signet; the
# image below ships bitcoind with mutinynet's signet challenge baked in.
# Swap for `bitcoin/bitcoin:25.0` + explicit -signetchallenge if you'd rather
# pin the official upstream and configure mutinynet via env.
BITCOIND_MUTINYNET_IMAGE=ghcr.io/mutinynet/bitcoind:latest
NBXPLORER_IMAGE=nicolasdorier/nbxplorer:2.6.7

# ─── Liquid plumbing (for the Liquid overlay) ────────────────────────────────
ELEMENTSD_IMAGE=blockstream/elementsd:23.2.7
