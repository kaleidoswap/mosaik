# Mosaik testnet — optional environment for the testnet UI and CLI.
#
# Copy to `.env` and source it before running ./scripts/testnet.sh:
#   cp .env.example .env
#   set -a; source .env; set +a
#   ./scripts/testnet.sh serve
#
# Or rely on testnet.sh, which sources `.env` automatically if present.

# ── Esplora ─────────────────────────────────────────────────────────────────
#
# Default: the free public instance (rate-limited).
# Override to point at Blockstream's Enterprise Esplora when you have a token
# (e.g. during the Turin event — token expires after one day).
#
# IMPORTANT: include the chain segment (`/liquidtestnet/api`) in the URL —
# the enterprise host serves multiple chains under one origin.

# ESPLORA_URL=https://us.enterprise.blockstream.info/liquidtestnet/api
# ESPLORA_TOKEN=eyJhbGciOi…   # the Bearer token from the Turin event

# ── Tools ───────────────────────────────────────────────────────────────────

# HAL_SIMPLICITY=/Users/you/.cargo/bin/hal-simplicity
