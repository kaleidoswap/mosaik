{
  "name": "@kaleidoswap/banco-proxy",
  "version": "0.1.0",
  "description": "Mosaik's HTTP gateway to @arkade-os/banco \u2014 exposes Maker/Taker as REST so the Rust workspace can drive Arkade swaps without an SDK port.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-banco-esm.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@arkade-os/banco": "github:arkade-os/banco",
    "@scure/base": "^1.2.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "@arkade-os/sdk": "github:louisinger/wallet-sdk#arkade-script-final"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@arkade-os/banco",
      "@arkade-os/sdk"
    ]
  }
}
